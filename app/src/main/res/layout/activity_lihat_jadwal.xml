<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradasi"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".LihatJadwal">

    <!-- 🔹 CardView Film -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/cardview_shadow_start_color"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:padding="28dp"> <!-- ✅ Tambah padding lebih besar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 🆔 ID Film -->
            <TextView
                android:id="@+id/textViewId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Film: 1"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="2dp"/>

            <!-- 🎬 Judul Film -->
            <TextView
                android:id="@+id/textViewJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Film"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:layout_marginStart="15dp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- 📅 Tanggal Tayang -->
            <TextView
                android:id="@+id/textViewTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal Tayang"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="8dp" />

            <!-- 🎭 Genre -->
            <TextView
                android:id="@+id/textViewGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="6dp" />

            <!-- 📝 Sinopsis -->
            <TextView
                android:id="@+id/textViewSinopsis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinopsis film akan muncul di sini"
                android:textColor="#BBBBBB"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 🔹 Tombol Kembali -->
    <Button
        android:id="@+id/buttonKembali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Kembali"
        android:backgroundTint="#2D2D2D"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:padding="10dp" />

</LinearLayout>