<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradasi"
    tools:context=".BuatJadwal">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Jadwal Film"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Judul Film -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Film"
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan judul film"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"
            android:textSize="16sp" />

        <!-- Tanggal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tanggal Tayang"
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="YYYY-MM-DD"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"
            android:inputType="text"
            android:autofillHints="date"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:textSize="16sp" />


        <!-- Jam -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Jam Tayang"
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextJam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 19:30"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"
            android:inputType="time"
            android:textSize="16sp" />

        <!-- Genre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Genre"
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Action, Drama, Horror"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"
            android:inputType="textPersonName"
            android:textSize="16sp" />

        <!-- Keterangan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keterangan"
            android:textColor="#E0E0E0"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextKeterangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deskripsi singkat film"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E9E9E"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textSize="16sp" />

        <!-- Tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/buttonSimpan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Simpan"
                android:backgroundTint="#388E3C"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonBatal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Batal"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
